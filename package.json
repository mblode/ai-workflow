{
  "name": "ai-workflow",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "portless run next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check-types": "tsc --noEmit",
    "export-pdf": "node scripts/export-pdf.mjs",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "if [ -z \"$VERCEL\" ]; then lefthook install; fi",
    "export-pptx": "node scripts/export-pptx.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@beautiful-qr-code/react": "^1.0.11",
    "blode-icons-react": "^0.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "deck-presenter": "*",
    "motion": "^14.6.0",
    "next": "^16.4.2",
    "posthog-js": "^1.414.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agentation": "^3.0.2",
    "jszip": "^3.10.2",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "playwright-core": "^1.63.0",
    "portless": "^0.15.4",
    "postcss": "^8.5.17",
    "pptxgenjs": "^4.0.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "ultracite": "7.9.3"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@12.0.2",
  "portless": "ai-workflow"
}
